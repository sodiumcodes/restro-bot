
# ==================================
# APPLICATION
# ==================================

APP_NAME=Cafe Chatbot
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO


# ==================================
# DATABASE
# ==================================

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cafe
POSTGRES_DB=cafe_chatbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_existing_password
# ==================================
# GROQ - LLM PROVIDER
# ==================================

GROQ_API_KEY=

# Model fallback configuration
LLM_MODELS_CONFIG=app/config/llm_models.yaml

# ==================================
# OPENROUTER - EMBEDDINGS
# ==================================

EMBEDDING_PROVIDER=openrouter

OPENROUTER_API_KEY=

EMBEDDING_MODEL=

# Must match the embedding model's output dimension
EMBEDDING_DIM=384


# ==================================
# STAFF AUTHENTICATION
# ==================================

STAFF_API_KEY=


# ==================================
# API CONFIGURATION
# ==================================

CORS_ORIGINS=["http://localhost:3000"]

MAX_MESSAGE_LENGTH=200

# Maximum quantity allowed per item
CART_MAX_QUANTITY=10


# ==================================
# RATE LIMITING
# ==================================

CHAT_RATE_LIMIT=10/minute
SESSION_RATE_LIMIT=5/minute


# ==================================
# DATA RETENTION
# ==================================

RETENTION_DAYS=30


# ==================================
# RETRIEVAL
# ==================================

RETRIEVAL_TOP_K=5
